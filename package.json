{
  "name": "calq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~55.0.0",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "firebase": "^12.19.0",
    "mathjs": "^15.2.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "expo lint src functions firestore-tests jest.setup.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-calq \"jest -c firestore-tests/jest.config.js\""
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "firebase-tools": "^15.32.1",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/firestore-tests/"
    ]
  },
  "overrides": {
    "react-dom": "19.2.0"
  }
}
